    if [[ ! "$nuevo" =~ ^[0-9]+$ ]] || [ "$nuevo" -lt 1 ] || [ "$nuevo" -gt 65535 ]; then
        echo -e "${C_RED}[!] ${T[Puerto no válido]:-Puerto no válido}.${C_RST}"; sleep 2; continue
    fi
