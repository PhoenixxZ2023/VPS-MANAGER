echo -e "${C_NEON_BLUE}╔══════════════════════════════════════════════╗${C_RST}"
echo -e "${C_NEON_BLUE} ${C_NEON_GREEN}         🐻 ${T[GESTIÓN DE DROPBEAR SSH]:-GESTIÓN DE DROPBEAR SSH}            ${C_NEON_BLUE} ${C_RST}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"

if [ "$is_running" -gt 0 ]; then
