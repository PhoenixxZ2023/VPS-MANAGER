            git clone https://github.com/ambrop72/badvpn.git >/dev/null 2>&1
            mkdir -p badvpn-build
            cd badvpn-build
            cmake ../badvpn -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1 >/dev/null 2>&1
