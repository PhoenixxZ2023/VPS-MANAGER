            && echo -e "${C_GREEN}[✔] CheckUser Multi-App iniciado.${C_RST}" \
            || echo -e "${C_RED}[!] ${T[No se pudo iniciar. Revisa: journalctl -u checkuser-multi]:-No se pudo iniciar. Revisa: journalctl -u checkuser-multi}${C_RST}"
    fi
    sleep 2 ;;
3)
    systemctl restart checkuser-multi 2>/dev/null
    sleep 1
    systemctl is-active --quiet checkuser-multi 2>/dev/null \
        && echo -e "${C_GREEN}[✔] CheckUser Multi-App reiniciado.${C_RST}" \
        || echo -e "${C_RED}[!] ${T[No se pudo reiniciar. Revisa: journalctl -u checkuser-multi]:-No se pudo reiniciar. Revisa: journalctl -u checkuser-multi}${C_RST}"
    sleep 2 ;;
4)
    read -p "⚠️ ${T[¿Desinstalar CheckUser Multi-App (puerto]:-¿Desinstalar CheckUser Multi-App (puerto} $CHKM_PORT)? (s/n): " conf_chkm
    if [[ "$conf_chkm" == "s" || "$conf_chkm" == "S" ]]; then
        echo -e "${C_YELLOW}[+] ${T[Desinstalando CheckUser Multi-App]:-Desinstalando CheckUser Multi-App}...${C_RST}"
        systemctl stop checkuser-multi 2>/dev/null
        systemctl disable checkuser-multi 2>/dev/null
        rm -f "$CHKM_UNIT"
        systemctl daemon-reload
        rm -rf "$CHKM_DIR"
        rm -f "$CHKM_PORT_FILE"
        iptables -D INPUT -p tcp --dport "$CHKM_PORT" -j ACCEPT 2>/dev/null
        iptables-save > /etc/iptables.up.rules 2>/dev/null
        ufw delete allow "$CHKM_PORT"/tcp >/dev/null 2>&1
        echo -e "${C_GREEN}[✔] ${T[CheckUser Multi-App desinstalado correctamente]:-CheckUser Multi-App desinstalado correctamente}.${C_RST}"
    else
        echo -e "${C_YELLOW}[!] ${T[Cancelado]:-Cancelado}.${C_RST}"
    fi
    sleep 2 ;;
0) break ;;
*) echo -e "${C_RED}[!] ${T[Opción inválida]:-Opción inválida}.${C_RST}"; sleep 1 ;;
esac
done
}

