[Unit]
Description=TURBO MULTIPROXY
After=network.target

[Service]
EnvironmentFile=/etc/turbo-multiproxy.conf
ExecStart=/usr/bin/python3 -B /etc/vps-manager/core/turbo-multiproxy/proxy.py --port ${PORT} --bhttp ${BHTTP} --websocket ${WS} --path ${WS_PATH}
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
