M_OPT5="🌐 Gestionar Panel Web (Dashboard UI)"
M_OPT6="🔄 Actualizar Script"
M_OPT7="👥 Instalar CheckUser (Multi-App)"
M_OPT8="🔧 Herramientas y Sistema (Avanzado)"
M_OPT88="❌ Desinstalar Script"
M_OPT0="🚪 Salir"
M_SEL="Seleccione una opción: "
M_ERR="Opción inválida."
fi
OS=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n 1 | cut -d "=" -f 2 | sed 's/"//g')
IP=$(curl -s --max-time 3 ipv4.icanhazip.com || hostname -I | awk '{print $1}')
RAM_TOTAL=$(free -m | awk 'NR==2{print $2}'); RAM_USED=$(free -m | awk 'NR==2{print $3}')
RAM_PER=$((RAM_USED * 100 / RAM_TOTAL)); RAM_STR=$(free -m | awk 'NR==2{printf "%s / %s MB", $3,$2}')
RAM_BAR=$(draw_bar $RAM_PER)
read -r _ u1 n1 s1 i1 w1 q1 sq1 st1 _ < /proc/stat; sleep 0.5; read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 _ < /proc/stat
CPU_TOT=$(( (u2+n2+s2+i2+w2+q2+sq2+st2) - (u1+n1+s1+i1+w1+q1+sq1+st1) ))
CPU_IDLE=$(( (i2+w2) - (i1+w1) ))
if [ "$CPU_TOT" -gt 0 ]; then CPU_PER=$(( (100 * (CPU_TOT - CPU_IDLE)) / CPU_TOT )); else CPU_PER=0; fi
[ "$CPU_PER" -gt 100 ] && CPU_PER=100; [ "$CPU_PER" -lt 0 ] && CPU_PER=0
CPU_BAR=$(draw_bar $CPU_PER)
CONECTADOS=$(ps -ef | grep -E "sshd|dropbear" | grep -v root | grep -v grep | wc -l)
USERS_CREADOS=$(awk -F: '$3 >= 1000 && $1 != "nobody" {c++} END{print c+0}' /etc/passwd)
ST_SSH=$(chk_svc ssh sshd)
ST_NGINX=$(chk_svc nginx)
ST_XRAY=$(chk_svc xray)
ST_BHTTP=$(chk_svc superflash-bhttp)
ST_STUNNEL=$(chk_svc stunnel4)
ST_WS=$(chk_svc wsproxy)
ST_HCR=$(chk_svc hcr-server)
ST_UDPGW=$(chk_svc badvpn-7300)
ST_DROPBEAR=$(chk_svc dropbear)
SUBDOMINIO=$( [ -f /etc/vps-manager/dominio ] && cat /etc/vps-manager/dominio || echo "${T[No Configurado]:-No Configurado}" )
echo -e "${C_NEON_BLUE}╔══════════════════════════════════════════════╗${C_RST}"
echo -e "${C_NEON_BLUE}  ${C_NEON_YELLOW}${M_TITLE}   ${C_NEON_BLUE} ${C_RST}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
echo -e "${C_NEON_BLUE}  ${C_NEON_GREEN}${M_OS}: ${C_RST} $OS"
echo -e "${C_NEON_BLUE}  ${C_NEON_GREEN}${M_IP}: ${C_RST} $IP"
echo -e "${C_NEON_BLUE}  ${C_NEON_GREEN}${M_DOM}: ${C_RST} $SUBDOMINIO"
echo -e "${C_NEON_BLUE}  ${C_NEON_GREEN}${M_CPU}: ${C_RST} $CPU_BAR"
echo -e "${C_NEON_BLUE}  ${C_NEON_GREEN}${M_RAM}:${C_RST} $RAM_BAR ($RAM_STR)"
echo -e "${C_NEON_BLUE}  ${C_NEON_GREEN}${M_USR}: ${C_RST} ${C_NEON_YELLOW}${USERS_CREADOS}${C_RST} ${M_CREATED} ${C_NEON_BLUE}|${C_RST} ${C_NEON_YELLOW}${CONECTADOS}${C_RST} ${M_ONLINE}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
echo -e "  ${C_NEON_BLUE}SSH: ${ST_SSH} ${C_NEON_BLUE}BADVPN: ${ST_UDPGW} ${C_NEON_BLUE}XRAY: ${ST_XRAY} ${C_NEON_BLUE}BHTTP: ${ST_BHTTP}"
echo -e "  ${C_NEON_BLUE}SSL: ${ST_STUNNEL} ${C_NEON_BLUE}WS: ${ST_WS} ${C_NEON_BLUE}DROPBEAR: ${ST_DROPBEAR} ${C_NEON_BLUE}HCR: ${ST_HCR}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
echo -e "${C_NEON_PURPLE}  ${M_CAT1}${C_RST}"
echo -e "  ${C_NEON_YELLOW}1.${C_RST} ${M_OPT1}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
echo -e "${C_NEON_PURPLE}  ${M_CAT2}${C_RST}"
echo -e "  ${C_NEON_YELLOW}2.${C_RST} ${M_OPT2}"
echo -e "  ${C_NEON_YELLOW}3.${C_RST} ${M_OPT3}"
echo -e "  ${C_NEON_YELLOW}4.${C_RST} ${M_OPT4}"
echo -e "  ${C_NEON_YELLOW}5.${C_RST} ${M_OPT5}"
echo -e "  ${C_NEON_YELLOW}6.${C_RST} ${M_OPT6}"
echo -e "  ${C_NEON_YELLOW}7.${C_RST} ${M_OPT7}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
echo -e "  ${C_NEON_YELLOW}8.${C_RST} ${M_OPT8}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
