    echo -e "  ${C_NEON_YELLOW}1.${C_RST} 🚀 ${T[Instalar Dropbear]:-Instalar Dropbear}"
fi

echo -e "  ${C_RED}0.${C_RST} 🔙 ${T[Volver al Menú Anterior]:-Volver al Menú Anterior}"
echo -e "${C_NEON_BLUE}╚══════════════════════════════════════════════╝${C_RST}"
read -p "${T[Seleccione una opción]:-Seleccione una opción}: " db_opt

case $db_opt in
1)
    if [ "$is_running" -gt 0 ]; then
        echo -e "${C_YELLOW}[+] ${T[Deteniendo y desinstalando Dropbear]:-Deteniendo y desinstalando Dropbear}...${C_RST}"
        systemctl stop dropbear 2>/dev/null
        systemctl disable dropbear 2>/dev/null
        
        for pidlim in $(screen -ls 2>/dev/null | grep "\.limiter" | awk '{print $1}'); do
            screen -r -S "$pidlim" -X quit 2>/dev/null
        done
        screen -wipe >/dev/null 2>&1
        pkill -f droplimiter 2>/dev/null
        pkill -9 dropbear 2>/dev/null
        
        apt-get remove dropbear -y >/dev/null 2>&1
        apt-get purge dropbear -y >/dev/null 2>&1
        apt-get autoremove -y >/dev/null 2>&1
        
        rm -rf /etc/default/dropbear
        rm -rf /etc/dropbear
        
        echo -e "${C_GREEN}[✔] ${T[Dropbear desinstalado correctamente]:-Dropbear desinstalado correctamente}.${C_RST}"
    else
        clear
        echo -e "${C_NEON_BLUE}╔══════════════════════════════════════════════╗${C_RST}"
        echo -e "${C_NEON_BLUE} ${C_NEON_GREEN}         ${T[INSTALADOR DROPBEAR SSH]:-INSTALADOR DROPBEAR SSH}               ${C_NEON_BLUE} ${C_RST}"
        echo -e "${C_NEON_BLUE}╚══════════════════════════════════════════════╝${C_RST}"
        
        echo -ne "${C_YELLOW}${T[¿Qué puerto principal quieres usar]:-¿Qué puerto principal quieres usar}? (1-65535): ${C_RST}"
        read porta
        
        if [[ ! "$porta" =~ ^[0-9]+$ ]] || [ "$porta" -lt 1 ] || [ "$porta" -gt 65535 ]; then
            echo -e "${C_RED}[!] ${T[Puerto no válido]:-Puerto no válido}.${C_RST}"
            sleep 2
            continue
        fi
        
        if ss -lntp 2>/dev/null | grep -q ":$porta "; then
            local svc=$(ss -lntp 2>/dev/null | grep ":$porta " | awk '{print $NF}' | cut -d'"' -f2)
            echo -e "${C_RED}[!] ${T[El puerto]:-El puerto} $porta ${T[ya está en uso por]:-ya está en uso por}: $svc${C_RST}"
            sleep 3
            continue
        fi
        
        echo -e "${C_YELLOW}[+] ${T[Instalando Dropbear]:-Instalando Dropbear}...${C_RST}"
        apt-get update -y >/dev/null 2>&1
        apt-get install dropbear -y >/dev/null 2>&1
        
        if ! grep -q "/bin/false" /etc/shells; then
            echo "/bin/false" >> /etc/shells
        fi
        
        sed -i '/^PasswordAuthentication/d' /etc/ssh/sshd_config
        echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
        sed -i '/^PermitTunnel/d' /etc/ssh/sshd_config
        echo "PermitTunnel yes" >> /etc/ssh/sshd_config
        
        mkdir -p /etc/dropbear
        touch /etc/dropbear/banner
        
        # 🚨 SOLUCIÓN: Eliminar líneas viejas y agregar nuevas al final
        sed -i '/^DROPBEAR_PORT=/d' /etc/default/dropbear
        sed -i '/^DROPBEAR_EXTRA_ARGS=/d' /etc/default/dropbear
        sed -i '/^NO_START=/d' /etc/default/dropbear
        
        echo "NO_START=0" >> /etc/default/dropbear
        echo "DROPBEAR_PORT=$porta" >> /etc/default/dropbear
        echo "DROPBEAR_EXTRA_ARGS=\"-p 110\"" >> /etc/default/dropbear
        echo "DROPBEAR_BANNER=\"/etc/dropbear/banner\"" >> /etc/default/dropbear
        echo "DROPBEAR_RECEIVE_WINDOW=65536" >> /etc/default/dropbear
        
        systemctl stop dropbear 2>/dev/null
        pkill -9 dropbear 2>/dev/null
        sleep 1
        
        systemctl daemon-reload
        systemctl enable dropbear >/dev/null 2>&1
        systemctl restart dropbear
        
        if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "active"; then
            ufw allow "$porta/tcp" >/dev/null 2>&1
            ufw allow "110/tcp" >/dev/null 2>&1
        fi
        
        systemctl restart ssh >/dev/null 2>&1
        
        sleep 2
        if systemctl is-active --quiet dropbear 2>/dev/null; then
            echo -e "${C_GREEN}[✔] ${T[Dropbear instalado y activo]:-Dropbear instalado y activo}.${C_RST}"
            echo -e "${C_CYAN}${T[Puertos]:-Puertos}: ${C_YELLOW}$porta${C_RST} (${T[principal) y]:-principal) y} ${C_YELLOW}110${C_RST} (extra)${C_RST}"
        else
            echo -e "${C_RED}[!] ${T[Dropbear NO pudo iniciar]:-Dropbear NO pudo iniciar}.${C_RST}"
            echo -e "${C_YELLOW}${T[Verifica con: systemctl status dropbear]:-Verifica con: systemctl status dropbear}${C_RST}"
        fi
    fi
    read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..."
    ;;
2)
    if [ "$is_running" -gt 0 ]; then
        echo -ne "${C_YELLOW}${T[Nuevo puerto principal]:-Nuevo puerto principal} (1-65535): ${C_RST}"
        read new_port
        
        if [[ "$new_port" =~ ^[0-9]+$ ]] && [ "$new_port" -ge 1 ] && [ "$new_port" -le 65535 ]; then
            if ss -lntp 2>/dev/null | grep -q ":$new_port "; then
                echo -e "${C_RED}[!] ${T[El puerto]:-El puerto} $new_port ${T[ya está en uso]:-ya está en uso}.${C_RST}"
            else
                sed -i '/^DROPBEAR_PORT=/d' /etc/default/dropbear
                echo "DROPBEAR_PORT=$new_port" >> /etc/default/dropbear
                
                if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "active"; then
                    ufw delete allow "$DROPBEAR_PORT_MAIN/tcp" >/dev/null 2>&1
                    ufw allow "$new_port/tcp" >/dev/null 2>&1
                fi
                
                systemctl restart dropbear
                echo -e "${C_GREEN}[✔] ${T[Puerto principal cambiado a]:-Puerto principal cambiado a} $new_port.${C_RST}"
            fi
        else
            echo -e "${C_RED}[!] ${T[Puerto inválido]:-Puerto inválido}.${C_RST}"
        fi
    else
        echo -e "${C_RED}[!] ${T[Dropbear no está activo. Instálalo primero]:-Dropbear no está activo. Instálalo primero}.${C_RST}"
    fi
    read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..."
    ;;
3)
    if [ "$is_running" -gt 0 ]; then
        echo -ne "${C_YELLOW}${T[Nuevo puerto extra]:-Nuevo puerto extra} (1-65535): ${C_RST}"
        read new_extra
        
        if [[ "$new_extra" =~ ^[0-9]+$ ]] && [ "$new_extra" -ge 1 ] && [ "$new_extra" -le 65535 ]; then
            if ss -lntp 2>/dev/null | grep -q ":$new_extra "; then
                echo -e "${C_RED}[!] ${T[El puerto]:-El puerto} $new_extra ${T[ya está en uso]:-ya está en uso}.${C_RST}"
            else
                sed -i '/^DROPBEAR_EXTRA_ARGS=/d' /etc/default/dropbear
                echo "DROPBEAR_EXTRA_ARGS=\"-p $new_extra\"" >> /etc/default/dropbear
                
                if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "active"; then
                    ufw delete allow "$DROPBEAR_PORT_EXTRA/tcp" >/dev/null 2>&1
                    ufw allow "$new_extra/tcp" >/dev/null 2>&1
                fi
                
                systemctl restart dropbear
                echo -e "${C_GREEN}[✔] ${T[Puerto extra cambiado a]:-Puerto extra cambiado a} $new_extra.${C_RST}"
            fi
        else
            echo -e "${C_RED}[!] ${T[Puerto inválido]:-Puerto inválido}.${C_RST}"
        fi
    else
        echo -e "${C_RED}[!] ${T[Dropbear no está activo. Instálalo primero]:-Dropbear no está activo. Instálalo primero}.${C_RST}"
    fi
    read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..."
    ;;
4)
    if [ "$is_running" -gt 0 ]; then
        if [ "$limiter_running" -gt 0 ]; then
            echo -e "${C_YELLOW}[+] ${T[Deteniendo Droplimiter]:-Deteniendo Droplimiter}...${C_RST}"
            for pidlim in $(screen -ls 2>/dev/null | grep "\.limiter" | awk '{print $1}'); do
                screen -r -S "$pidlim" -X quit 2>/dev/null
            done
            screen -wipe >/dev/null 2>&1
            pkill -f droplimiter 2>/dev/null
            echo -e "${C_GREEN}[✔] ${T[Droplimiter desactivado]:-Droplimiter desactivado}.${C_RST}"
        else
            if ! command -v droplimiter >/dev/null 2>&1; then
                echo -e "${C_YELLOW}[+] ${T[Descargando Droplimiter desde GitHub]:-Descargando Droplimiter desde GitHub}...${C_RST}"
                wget -qO /usr/local/bin/droplimiter https://raw.githubusercontent.com/PhoenixxZ2023/VPS-MANAGER/main/core/droplimiter
                chmod +x /usr/local/bin/droplimiter 2>/dev/null
            fi
            
            if command -v droplimiter >/dev/null 2>&1; then
                echo -e "${C_YELLOW}[+] ${T[Activando Droplimiter en background]:-Activando Droplimiter en background}...${C_RST}"
                screen -dmS limiter droplimiter
                sleep 1
                echo -e "${C_GREEN}[✔] ${T[Droplimiter activado]:-Droplimiter activado}.${C_RST}"
            else
                echo -e "${C_RED}[!] ${T[No se pudo descargar droplimiter]:-No se pudo descargar droplimiter}.${C_RST}"
            fi
        fi
    else
        echo -e "${C_RED}[!] ${T[Dropbear no está activo. Instálalo primero]:-Dropbear no está activo. Instálalo primero}.${C_RST}"
    fi
    read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..."
    ;;
5)
    if [ "$is_running" -gt 0 ]; then
        echo -e "${C_YELLOW}[+] ${T[Reiniciando Dropbear]:-Reiniciando Dropbear}...${C_RST}"
        systemctl restart dropbear
        echo -e "${C_GREEN}[✔] ${T[Servicio reiniciado]:-Servicio reiniciado}.${C_RST}"
    else
        echo -e "${C_RED}[!] ${T[Dropbear no está activo]:-Dropbear no está activo}.${C_RST}"
    fi
    read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..."
    ;;
0) break ;;
*) echo -e "${C_RED}[!] ${T[Opción inválida]:-Opción inválida}.${C_RST}"; sleep 1 ;;
esac
done
}

menu_ssl() {
while true; do
clear
local SSL_CONF="" SSL_PORT="No configurado" is_installed=0 is_running=0
SSL_CONF=$(grep -l -E '^[[:space:]]*accept[[:space:]]*=' /etc/stunnel/*.conf 2>/dev/null | head -n1)
if command -v stunnel4 >/dev/null 2>&1 && [ -n "$SSL_CONF" ]; then
    is_installed=1
    SSL_PORT=$(grep -m1 -E '^[[:space:]]*accept[[:space:]]*=' "$SSL_CONF" | sed -E 's/.*=[[:space:]]*//; s/.*://; s/[[:space:]]//g')
    [ -z "$SSL_PORT" ] && SSL_PORT=$(cat /etc/vps-manager/ssl_port 2>/dev/null || echo "${T[No configurado]:-No configurado}")
    systemctl is-active --quiet stunnel4 2>/dev/null && is_running=1
fi

echo -e "${C_NEON_BLUE}╔══════════════════════════════════════════════╗${C_RST}"
echo -e "${C_NEON_BLUE} ${C_NEON_GREEN}         🔒 ${T[GESTIÓN SSL / TLS (STUNNEL]:-GESTIÓN SSL / TLS (STUNNEL})       ${C_NEON_BLUE} ${C_RST}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"

if [ "$is_installed" -eq 1 ]; then
    if [ "$is_running" -eq 1 ]; then
        echo -e "  ${T[Estado]:-Estado}: ${C_GREEN}✅ ${T[ACTIVO]:-ACTIVO}${C_RST}"
    else
        echo -e "  ${T[Estado]:-Estado}: ${C_RED}⏹️ ${T[DETENIDO]:-DETENIDO}${C_RST}"
    fi
    echo -e "  ${T[Puerto]:-Puerto}: ${C_NEON_YELLOW}${SSL_PORT}${C_RST}"
    echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
    echo -e "  ${C_NEON_YELLOW}1.${C_RST} 🔌 ${T[Cambiar Puerto]:-Cambiar Puerto}"
    if [ "$is_running" -eq 1 ]; then
        echo -e "  ${C_NEON_YELLOW}2.${C_RST} ⏹️ ${T[Detener Servicio]:-Detener Servicio}"
    else
        echo -e "  ${C_NEON_YELLOW}2.${C_RST} ▶️ ${T[Iniciar Servicio]:-Iniciar Servicio}"
    fi
    echo -e "  ${C_NEON_YELLOW}3.${C_RST} 🔄 ${T[Reiniciar Servicio]:-Reiniciar Servicio}"
    echo -e "  ${C_NEON_YELLOW}4.${C_RST} 🗑️ ${T[Desinstalar SSL / TLS]:-Desinstalar SSL / TLS}"
else
    echo -e "  ${T[Estado]:-Estado}: ${C_RED}❌ ${T[NO INSTALADO]:-NO INSTALADO}${C_RST}"
    echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
    echo -e "  ${C_NEON_YELLOW}1.${C_RST} 🚀 ${T[Instalar SSL / TLS]:-Instalar SSL / TLS}"
fi
echo -e "  ${C_RED}0.${C_RST} 🔙 ${T[Volver al Menú Anterior]:-Volver al Menú Anterior}"
echo -e "${C_NEON_BLUE}╚══════════════════════════════════════════════╝${C_RST}"
read -p "${T[Seleccione una opción]:-Seleccione una opción}: " ssl_opt

if [ "$is_installed" -eq 0 ]; then
    case $ssl_opt in
    1)
        clear
        wget -qO /tmp/ssl.sh https://raw.githubusercontent.com/PhoenixxZ2023/VPS-MANAGER/main/core/ssl.sh && chmod +x /tmp/ssl.sh && bash /tmp/ssl.sh
        read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..." ;;
    0) break ;;
    *) echo -e "${C_RED}[!] ${T[Opción inválida]:-Opción inválida}.${C_RST}"; sleep 1; continue ;;
    esac
    continue
fi

case $ssl_opt in
1)
    echo -ne "${C_YELLOW}${T[Nuevo puerto SSL]:-Nuevo puerto SSL} (1-65535): ${C_RST}"
    read nuevo
    if [[ ! "$nuevo" =~ ^[0-9]+$ ]] || [ "$nuevo" -lt 1 ] || [ "$nuevo" -gt 65535 ]; then
        echo -e "${C_RED}[!] ${T[Puerto no válido]:-Puerto no válido}.${C_RST}"; sleep 2; continue
    fi
    if [ "$nuevo" = "$SSL_PORT" ]; then
        echo -e "${C_YELLOW}[!] ${T[Ya está usando el puerto]:-Ya está usando el puerto} $nuevo.${C_RST}"; sleep 2; continue
    fi
    if ss -lntp 2>/dev/null | grep -q ":$nuevo "; then
        local svc=$(ss -lntp 2>/dev/null | grep ":$nuevo " | awk '{print $NF}' | cut -d'"' -f2 | head -n1)
        echo -e "${C_RED}[!] ${T[El puerto]:-El puerto} $nuevo ${T[ya está en uso por]:-ya está en uso por}: $svc${C_RST}"; sleep 3; continue
    fi
    local ln=$(grep -n -m1 -E '^[[:space:]]*accept[[:space:]]*=' "$SSL_CONF" | cut -d: -f1)
    cp "$SSL_CONF" "${SSL_CONF}.bak"
    sed -i -E "${ln}s/^([[:space:]]*accept[[:space:]]*=[[:space:]]*)(.*:)?[0-9]+/\1\2${nuevo}/" "$SSL_CONF"
    mkdir -p /etc/vps-manager
    echo "$nuevo" > /etc/vps-manager/ssl_port
    command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active" && ufw allow "$nuevo"/tcp >/dev/null 2>&1
    systemctl restart stunnel4 2>/dev/null
    sleep 1
    if systemctl is-active --quiet stunnel4 2>/dev/null; then
        echo -e "${C_GREEN}[✔] ${T[Puerto cambiado a]:-Puerto cambiado a} $nuevo ${T[y servicio reiniciado]:-y servicio reiniciado}.${C_RST}"
    else
        mv "${SSL_CONF}.bak" "$SSL_CONF"
        echo "$SSL_PORT" > /etc/vps-manager/ssl_port
        systemctl restart stunnel4 2>/dev/null
        echo -e "${C_RED}[!] ${T[No arrancó con el nuevo puerto. Se restauró el puerto]:-No arrancó con el nuevo puerto. Se restauró el puerto} $SSL_PORT.${C_RST}"
    fi
    read -p "${T[Presione Enter para continuar]:-Presione Enter para continuar}..." ;;
2)
    if [ "$is_running" -eq 1 ]; then
        systemctl stop stunnel4 2>/dev/null
        echo -e "${C_GREEN}[✔] ${T[Servicio SSL detenido]:-Servicio SSL detenido}.${C_RST}"
    else
        systemctl start stunnel4 2>/dev/null
        sleep 1
        systemctl is-active --quiet stunnel4 2>/dev/null \
            && echo -e "${C_GREEN}[✔] ${T[Servicio SSL iniciado]:-Servicio SSL iniciado}.${C_RST}" \
            || echo -e "${C_RED}[!] ${T[No se pudo iniciar. Revisa: journalctl -u stunnel]:-No se pudo iniciar. Revisa: journalctl -u stunnel}4${C_RST}"
    fi
    sleep 2 ;;
3)
    systemctl restart stunnel4 2>/dev/null
    sleep 1
    systemctl is-active --quiet stunnel4 2>/dev/null \
        && echo -e "${C_GREEN}[✔] ${T[Servicio SSL reiniciado]:-Servicio SSL reiniciado}.${C_RST}" \
        || echo -e "${C_RED}[!] ${T[No se pudo reiniciar. Revisa: journalctl -u stunnel]:-No se pudo reiniciar. Revisa: journalctl -u stunnel}4${C_RST}"
    sleep 2 ;;
4)
    read -p "⚠️ ${T[¿Desinstalar SSL / TLS (puerto]:-¿Desinstalar SSL / TLS (puerto} $SSL_PORT)? (s/n): " conf_ssl
    if [[ "$conf_ssl" == "s" || "$conf_ssl" == "S" ]]; then
        echo -e "${C_YELLOW}[+] ${T[Desinstalando SSL / TLS]:-Desinstalando SSL / TLS}...${C_RST}"
        systemctl stop stunnel4 2>/dev/null
        systemctl disable stunnel4 2>/dev/null
        pkill -9 stunnel4 2>/dev/null
        apt-get remove --purge stunnel4 -y >/dev/null 2>&1
        apt-get autoremove -y >/dev/null 2>&1
        rm -rf /etc/stunnel
        rm -f /etc/default/stunnel4
        rm -f /etc/vps-manager/ssl_port
        command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active" && ufw delete allow "$SSL_PORT"/tcp >/dev/null 2>&1
        echo -e "${C_GREEN}[✔] ${T[SSL / TLS desinstalado correctamente]:-SSL / TLS desinstalado correctamente}.${C_RST}"
    else
        echo -e "${C_YELLOW}[!] ${T[Cancelado]:-Cancelado}.${C_RST}"
    fi
    sleep 2 ;;
0) break ;;
*) echo -e "${C_RED}[!] ${T[Opción inválida]:-Opción inválida}.${C_RST}"; sleep 1 ;;
esac
done
}

menu_checkuser_multi() {
local CHKM_DIR="/etc/vps-manager/checkuser"
local CHKM_UNIT="/etc/systemd/system/checkuser-multi.service"
local CHKM_OLD="/etc/systemd/system/checkuser.service"
local CHKM_PORT_FILE="/etc/vps-manager/checkuser_multi_port"
# Migrar instalación antigua (checkuser.service -> checkuser-multi.service)
if [ -f "$CHKM_OLD" ] && grep -q "Multi-App" "$CHKM_OLD" 2>/dev/null; then
    systemctl stop checkuser 2>/dev/null
    systemctl disable checkuser 2>/dev/null
    mv "$CHKM_OLD" "$CHKM_UNIT"
    systemctl daemon-reload
    systemctl enable checkuser-multi >/dev/null 2>&1
    systemctl restart checkuser-multi 2>/dev/null
fi
while true; do
clear
local is_installed=0 is_running=0 CHKM_PORT="No configurado"
if [ -f "$CHKM_DIR/check.py" ] && [ -f "$CHKM_UNIT" ]; then
    is_installed=1
    CHKM_PORT=$(grep -m1 -oE 'def run\(port=[0-9]+' "$CHKM_DIR/check.py" | grep -oE '[0-9]+')
    [ -z "$CHKM_PORT" ] && CHKM_PORT=$(cat "$CHKM_PORT_FILE" 2>/dev/null || echo "5432")
    systemctl is-active --quiet checkuser-multi 2>/dev/null && is_running=1
fi

echo -e "${C_NEON_BLUE}╔══════════════════════════════════════════════╗${C_RST}"
echo -e "${C_NEON_BLUE} ${C_NEON_GREEN}        👥 ${T[GESTIÓN CHECKUSER MULTI-APP]:-GESTIÓN CHECKUSER MULTI-APP}         ${C_NEON_BLUE} ${C_RST}"
echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
if [ "$is_installed" -eq 1 ]; then
    if [ "$is_running" -eq 1 ]; then
